# Copy this file to .env and fill in real values (never commit the real .env)
#
# Get these from https://discord.com/developers/applications → your app:
# - DISCORD_PUBLIC_KEY: General Information tab
# - DISCORD_BOT_TOKEN: Bot tab → Reset Token (only shown once, save it)
# - DISCORD_APPLICATION_ID: General Information tab, "Application ID"

DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Only needed if you register the command per-guild for instant testing
# instead of globally (see register-commands.js) — right-click your server
# icon in Discord with Developer Mode on to copy this.
GUILD_ID=
